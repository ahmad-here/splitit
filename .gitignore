# ─────────────────────────────────────────────────────────────
# Splitit monorepo — frontend (splitit/) + backend (splitit-server/)
# Patterns without a leading slash apply at any depth, so they cover
# both projects.
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases

# ── Secrets / environment ────────────────────────────────────
# NEVER commit real keys (GEMINI_API_KEY lives in splitit-server/.env.local).
# The .env.example templates ARE committed.
.env
.env.*
!.env.example

# ── Expo / React Native (splitit/) ───────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects generated by `expo prebuild` (regenerate, don't commit)
/splitit/android/
/splitit/ios/

# Signing / credentials — never commit
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro / merge artifacts
*.orig.*
.metro-health-check*

# ── Next.js (splitit-server/) ────────────────────────────────
.next/
out/
build/
next-env.d.ts
.vercel

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo

# ── Tests / coverage ─────────────────────────────────────────
coverage/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS noise ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors ──────────────────────────────────────────────────
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Claude Code (keep shared hooks/skills, ignore local overrides) ──
.claude/settings.local.json
