# Active LLM provider: "gemini" (default) or "openai"
LLM_PROVIDER=gemini

# Google Gemini (required when LLM_PROVIDER=gemini)
# Use an explicit vision-capable model (avoid the *-latest alias, which can
# resolve to a variant that rejects image input). Alternatives: gemini-3.1-flash-lite,
# gemini-3-flash-preview. (gemini-2.5-flash is blocked for new accounts.)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# OpenAI (only when LLM_PROVIDER=openai — provider is a stub until enabled)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
