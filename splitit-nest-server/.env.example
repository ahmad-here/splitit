# Active LLM provider: "gemini" (default) or "openai"
LLM_PROVIDER=gemini

# Google Gemini (required when LLM_PROVIDER=gemini)
# Use an explicit vision-capable model (avoid the *-latest alias, which can
# resolve to a variant that rejects image input).
# NOTE: gemini-3.5-flash is frequently overloaded (503 / multi-minute hangs) and
# its extended thinking is wasted on receipt extraction — flash-lite answers the
# same prompts in ~1s. Alternatives: gemini-3-flash-preview, gemini-2.0-flash.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# Reasoning depth: LOW (default) | MEDIUM | HIGH. Extraction/assignment do not
# need a long thinking chain; higher levels mostly add latency.
# GEMINI_THINKING=LOW

# Retries on transient upstream failures (429/503).
# GEMINI_MAX_RETRIES=2

# Per-request ceiling in ms. Prevents an overloaded model from hanging the app.
# LLM_TIMEOUT_MS=45000

# ngrok tunnel (npm run tunnel) — gives the Expo app an https:// URL, which
# Android 9+ requires (plain http:// to a LAN IP is blocked as cleartext).
# Free token: https://dashboard.ngrok.com/get-started/your-authtoken
# 
# Optional: a reserved domain so the URL survives restarts. Without it ngrok
# issues a new random URL each run and splitit/.env.local must be updated.
# NGROK_DOMAIN=your-name.ngrok-free.app

# Firebase Admin (required for accounts, members, notifications, chats, push).
# Firebase console → Project settings → Service accounts → Generate new private
# key. Save the downloaded JSON as splitit-nest-server/service-account.json
# (gitignored) and point to it below. This bypasses Firestore security rules —
# server only, never ship it in the app.
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Alternatively, inline the JSON as a single line (harder to escape):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Cloudinary — stores receipt images (free tier; avoids the paid Firebase
# Storage plan). Dashboard → Product Environment Credentials.
# Easiest: paste the single CLOUDINARY_URL. Server-side signed uploads, so no
# unsigned upload preset is needed.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or set them individually instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# LangSmith tracing (optional) — observe every LLM + LangGraph run at
# https://smith.langchain.com. Create a key under Settings → API Keys. When
# LANGSMITH_TRACING=true and a key are set, LangChain auto-traces; no code change.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=splitit
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# OpenAI (only when LLM_PROVIDER=openai — provider is a stub until enabled)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
