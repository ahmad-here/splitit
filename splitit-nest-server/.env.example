# Active LLM provider: "gemini" (default) or "openai"
LLM_PROVIDER=gemini

# Google Gemini (required when LLM_PROVIDER=gemini)
# Use an explicit vision-capable model (avoid the *-latest alias, which can
# resolve to a variant that rejects image input).
# NOTE: gemini-3.5-flash is frequently overloaded (503 / multi-minute hangs) and
# its extended thinking is wasted on receipt extraction — flash-lite answers the
# same prompts in ~1s. Alternatives: gemini-3-flash-preview, gemini-2.0-flash.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# Reasoning depth: LOW (default) | MEDIUM | HIGH. Extraction/assignment do not
# need a long thinking chain; higher levels mostly add latency.
# GEMINI_THINKING=LOW

# Retries on transient upstream failures (429/503).
# GEMINI_MAX_RETRIES=2

# Per-request ceiling in ms. Prevents an overloaded model from hanging the app.
# LLM_TIMEOUT_MS=45000

# ngrok tunnel (npm run tunnel) — gives the Expo app an https:// URL, which
# Android 9+ requires (plain http:// to a LAN IP is blocked as cleartext).
# Free token: https://dashboard.ngrok.com/get-started/your-authtoken
# 
# Optional: a reserved domain so the URL survives restarts. Without it ngrok
# issues a new random URL each run and splitit/.env.local must be updated.
# NGROK_DOMAIN=your-name.ngrok-free.app

# OpenAI (only when LLM_PROVIDER=openai — provider is a stub until enabled)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
