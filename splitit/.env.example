# Splitit app — public build-time config (Expo inlines EXPO_PUBLIC_* into the bundle).
# These are NOT secret. Copy this file to .env.local and set your values.
# The server's GEMINI_API_KEY lives in splitit-server/.env.local, never here.

# Backend base URL the app calls. REQUIRED — this is the only source of the URL
# (it is not editable in-app or saved on the device). Use your machine's LAN IP
# so a physical device can reach the dev server, e.g. http://192.168.1.10:3000,
# or a deployed URL such as https://api.yourdomain.com
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000

# Currency symbol/prefix shown across the UI.
EXPO_PUBLIC_CURRENCY=Rs

# Firebase Web app config — Console → Project settings → Your apps → Web app.
# Required for accounts, members, notifications, and chat persistence.


# Google sign-in (optional). Web client id is auto-created when Google sign-in
# is enabled in Firebase; native ids come from Google Cloud OAuth credentials.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
